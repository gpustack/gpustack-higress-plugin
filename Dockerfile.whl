# Runtime-only Dockerfile that installs a pre-built wheel from the build
# context (dist/*.whl). Used by the manual image workflow (.github/workflows/
# image.yaml), which downloads the wheel from a tagged GitHub Release.
#
# Usage:
#   # Put the released wheel in ./dist first, then:
#   docker build -f Dockerfile.whl -t gpustack-higress-plugins .

FROM python:3.11-slim

WORKDIR /app

# Copy pre-built wheel(s) from the build context and install
COPY dist/*.whl /tmp/dist/

RUN pip install --no-cache-dir --break-system-packages /tmp/dist/*.whl && \
    rm -rf /tmp/dist

# Create a non-root user
RUN useradd -m -u 1000 plugins && \
    chown -R plugins:plugins /app

USER plugins

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "from urllib.request import urlopen; urlopen('http://localhost:8080/', timeout=2)" || exit 1

# Set default command to start the plugin server
CMD ["gpustack-plugins", "start", "--port", "8080", "--host", "0.0.0.0"]
